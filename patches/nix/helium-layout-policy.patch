+caption: Browser layout
+desc: |-
+  Sets the <ph name="PRODUCT_NAME">$1<ex>Google Chrome</ex></ph> browser layout: the classic horizontal tab strip, the compact layout, vertical tabs, or the dynamic layout.
+
+  If this policy is set, the layout is fixed and users can't change it.
+
+  If this policy is not set, users can pick the layout in settings.
+example_value: 2
+features:
+  dynamic_refresh: true
+  per_profile: true
+items:
+- caption: Classic layout
+  name: Classic
+  value: 0
+- caption: Compact layout
+  name: Compact
+  value: 1
+- caption: Vertical tabs
+  name: Vertical
+  value: 2
+- caption: Dynamic layout
+  name: Dynamic
+  value: 3
+owners:
+- file://components/policy/OWNERS
+schema:
+  enum:
+  - 0
+  - 1
+  - 2
+  - 3
+  type: integer
+supported_on:
+- chrome.linux:156-
+- chrome.win:156-
+- chrome.mac:156-
+tags: []
+type: int-enum
