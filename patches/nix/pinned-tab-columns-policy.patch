+caption: Pinned tab columns
+desc: |-
+  Sets the maximum number of pinned tabs shown side by side in each row of the <ph name="PRODUCT_NAME">$1<ex>Google Chrome</ex></ph> vertical tab strip while it is expanded. The tabs in a row share the full width of the tab strip.
+
+  If this policy is set to 0 or not set, as many pinned tabs as fit the tab strip width are shown on each row.
+
+  The collapsed vertical tab strip always shows one pinned tab per row, and the horizontal tab strip is not affected.
+example_value: 2
+features:
+  dynamic_refresh: true
+  per_profile: true
+owners:
+- file://components/policy/OWNERS
+schema:
+  maximum: 10
+  minimum: 0
+  type: integer
+supported_on:
+- chrome.linux:156-
+- chrome.win:156-
+- chrome.mac:156-
+tags: []
+type: int
