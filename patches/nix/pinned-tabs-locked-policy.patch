@@ -0,0 +1,28 @@
+caption: Lock pinned tabs
+desc: |-
+  Freezes the pinned tabs of <ph name="PRODUCT_NAME">$1<ex>Google Chrome</ex></ph> to the PinnedTabs list.
+
+  If this policy is enabled, the pins shared by the windows of a profile are exactly the PinnedTabs URLs (one per host, ignoring a leading "www."), in that order. Users can't unpin, move, drag, split or move them to another window, or change their pinned URL; closing one only hibernates it. Users can't pin other tabs either, and pins that aren't in the PinnedTabs list (e.g. from an earlier session) become regular tabs.
+
+  If this policy is disabled or not set, pinned tabs behave as usual.
+
+  Incognito and guest windows are not affected.
+example_value: true
+features:
+  dynamic_refresh: true
+  per_profile: true
+items:
+- caption: Freeze the policy pinned tabs
+  value: true
+- caption: Let users manage pinned tabs
+  value: false
+owners:
+- file://components/policy/OWNERS
+schema:
+  type: boolean
+supported_on:
+- chrome.linux:156-
+- chrome.win:156-
+- chrome.mac:156-
+tags: []
+type: main
