+void HeliumPinsService::ApplyLockedPolicyPins() {
+  // Each policy URL keeps the first pin with its key, or gets a new one.
+  PinList locked_pins;
+  for (const GURL& url : GetPolicyPinUrls()) {
+    const std::string key = GetPolicyPinKey(url);
+    const auto it = std::ranges::find_if(pins_, [&key](const Pin& pin) {
+      return GetPolicyPinKey(pin.url) == key;
+    });
+    locked_pins.insert(locked_pins.end(),
+                       it != pins_.end() ? *it : Pin{CreatePinId(), url});
+  }
+
+  // Splits only stay between pins that are still next to each other.
+  for (size_t i = 0; i < locked_pins.size(); ++i) {
+    Pin& pin = locked_pins[i];
+    if (pin.split.empty()) {
+      continue;
+    }
+
+    const bool is_first = pin.split == pin.id && i + 1 < locked_pins.size() &&
+                          locked_pins[i + 1].split == pin.id;
+    const bool is_second = i > 0 && locked_pins[i - 1].id == pin.split &&
+                           locked_pins[i - 1].split == pin.split;
+    if (!is_first && !is_second) {
+      pin.split.clear();
+      pin.split_visual_data = split_tabs::SplitTabVisualData();
+    }
+  }
+
+  if (locked_pins.ToPref() != pins_.ToPref()) {
+    pins_ = std::move(locked_pins);
+    SavePins();
+  }
+
+  // Windows unpin the pins that were dropped, add the missing ones and take
+  // the policy order.
+  ScheduleReconcileOthers(nullptr);
+}
+
