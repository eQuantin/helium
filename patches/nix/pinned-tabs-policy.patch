+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_BROWSER_WINDOW_INTERNAL_PINNED_TABS_POLICY_CONTROLLER_H_
+#define CHROME_BROWSER_UI_BROWSER_WINDOW_INTERNAL_PINNED_TABS_POLICY_CONTROLLER_H_
+
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "components/prefs/pref_change_registrar.h"
+
+class BrowserWindowInterface;
+
+// Keeps the URLs of the PinnedTabs policy open as pinned tabs in a normal
+// browser window. A URL counts as present when a pinned tab with the same
+// host (ignoring a leading "www.") exists, so navigating inside a pinned tab
+// doesn't spawn a duplicate. Missing URLs are appended to the pinned group,
+// in policy order, once the window's initial tabs (e.g. session restore) are
+// in, and again whenever the policy changes.
+class PinnedTabsPolicyController {
+ public:
+  explicit PinnedTabsPolicyController(BrowserWindowInterface* browser);
+  ~PinnedTabsPolicyController();
+
+  PinnedTabsPolicyController(const PinnedTabsPolicyController&) = delete;
+  PinnedTabsPolicyController& operator=(const PinnedTabsPolicyController&) =
+      delete;
+
+ private:
+  void ScheduleApply();
+  void Apply();
+
+  const raw_ptr<BrowserWindowInterface> browser_;
+  PrefChangeRegistrar pref_change_registrar_;
+  base::WeakPtrFactory<PinnedTabsPolicyController> weak_ptr_factory_{this};
+};
+
+#endif  // CHROME_BROWSER_UI_BROWSER_WINDOW_INTERNAL_PINNED_TABS_POLICY_CONTROLLER_H_
