@@ -0,0 +1,27 @@
+caption: Pinned tabs
+desc: |-
+  Keeps a list of URLs among the pinned tabs that <ph name="PRODUCT_NAME">$1<ex>Google Chrome</ex></ph> shares between all windows of a profile.
+
+  When the browser starts, and whenever this policy changes, each URL whose host (ignoring a leading "www.") no pin has as its pinned URL is added as a pin, after the existing pins, and shows up hibernated in every window. Navigating inside such a pin doesn't add a duplicate. Users can still close (hibernate) or unpin these pins; an unpinned one comes back the next time the browser starts or the policy changes.
+
+  Incognito and guest windows are not affected.
+
+  If this policy is not set, no tabs are pinned automatically.
+example_value:
+- https://www.youtube.com/
+- https://www.twitch.tv/
+features:
+  dynamic_refresh: true
+  per_profile: true
+owners:
+- file://components/policy/OWNERS
+schema:
+  items:
+    type: string
+  type: array
+supported_on:
+- chrome.linux:156-
+- chrome.win:156-
+- chrome.mac:156-
+tags: []
+type: list
