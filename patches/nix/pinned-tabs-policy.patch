+std::vector<GURL> HeliumPinsService::GetPolicyPinUrls() const {
+  std::vector<GURL> urls;
+  if (!prefs_) {
+    return urls;
+  }
+
+  std::set<std::string> keys;
+  for (const base::Value& value :
+       prefs_->GetList(prefs::kHeliumPolicyPinnedTabs)) {
+    if (!value.is_string()) {
+      continue;
+    }
+
+    GURL url(value.GetString());
+    if (url.is_valid() && keys.insert(GetPolicyPinKey(url)).second) {
+      urls.push_back(std::move(url));
+    }
+  }
+
+  return urls;
+}
+
+void HeliumPinsService::ApplyPolicyPins() {
+  if (browser_shutdown::HasShutdownStarted()) {
+    return;
+  }
+
+  std::set<std::string> present;
+  for (const Pin& pin : pins_) {
+    present.insert(GetPolicyPinKey(pin.url));
+  }
+
+  bool changed = false;
+  for (const GURL& url : GetPolicyPinUrls()) {
+    if (present.insert(GetPolicyPinKey(url)).second) {
+      pins_.insert(pins_.end(), Pin{CreatePinId(), url});
+      changed = true;
+    }
+  }
+
+  // Every window gets a hibernated copy of the new pins.
+  if (changed) {
+    SavePins();
+    ScheduleReconcileOthers(nullptr);
+  }
+}
+
 }  // namespace helium_pins
