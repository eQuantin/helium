+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/browser_window/internal/pinned_tabs_policy_controller.h"
+
+#include <set>
+#include <string>
+#include <string_view>
+
+#include "base/functional/bind.h"
+#include "base/location.h"
+#include "base/strings/string_util.h"
+#include "base/task/single_thread_task_runner.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/navigator/browser_navigator.h"
+#include "chrome/browser/ui/navigator/browser_navigator_params.h"
+#include "chrome/browser/ui/tabs/tab_enums.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/common/pref_names.h"
+#include "components/prefs/pref_service.h"
+#include "content/public/browser/web_contents.h"
+#include "ui/base/page_transition_types.h"
+#include "ui/base/window_open_disposition.h"
+#include "url/gurl.h"
+
+namespace {
+
+std::string NormalizedHost(const GURL& url) {
+  std::string_view host = url.host();
+  if (base::StartsWith(host, "www.")) {
+    host.remove_prefix(4);
+  }
+  return std::string(host);
+}
+
+}  // namespace
+
+PinnedTabsPolicyController::PinnedTabsPolicyController(
+    BrowserWindowInterface* browser)
+    : browser_(browser) {
+  pref_change_registrar_.Init(browser_->GetProfile()->GetPrefs());
+  pref_change_registrar_.Add(
+      prefs::kHeliumPolicyPinnedTabs,
+      base::BindRepeating(&PinnedTabsPolicyController::ScheduleApply,
+                          base::Unretained(this)));
+  // The window is created before its initial tabs (startup URLs, session
+  // restore, a dragged-out tab) are added; check once they are in.
+  ScheduleApply();
+}
+
+PinnedTabsPolicyController::~PinnedTabsPolicyController() = default;
+
+void PinnedTabsPolicyController::ScheduleApply() {
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&PinnedTabsPolicyController::Apply,
+                                weak_ptr_factory_.GetWeakPtr()));
+}
+
+void PinnedTabsPolicyController::Apply() {
+  if (browser_->IsDeleteScheduled()) {
+    return;
+  }
+  const base::ListValue& urls =
+      browser_->GetProfile()->GetPrefs()->GetList(
+          prefs::kHeliumPolicyPinnedTabs);
+  if (urls.empty()) {
+    return;
+  }
+
+  TabStripModel* tab_strip_model = browser_->GetTabStripModel();
+  std::set<std::string> present;
+  for (int i = 0; i < tab_strip_model->IndexOfFirstNonPinnedTab(); ++i) {
+    present.insert(
+        NormalizedHost(tab_strip_model->GetWebContentsAt(i)->GetVisibleURL()));
+  }
+
+  for (const base::Value& value : urls) {
+    if (!value.is_string()) {
+      continue;
+    }
+    GURL url(value.GetString());
+    if (!url.is_valid()) {
+      continue;
+    }
+    if (!present.insert(NormalizedHost(url)).second) {
+      continue;
+    }
+    NavigateParams params(browser_.get(), url,
+                          ui::PAGE_TRANSITION_AUTO_TOPLEVEL);
+    params.disposition = WindowOpenDisposition::NEW_BACKGROUND_TAB;
+    params.tabstrip_index = tab_strip_model->IndexOfFirstNonPinnedTab();
+    params.tabstrip_add_types =
+        AddTabTypes::ADD_PINNED | AddTabTypes::ADD_FORCE_INDEX;
+    Navigate(&params);
+  }
+}
